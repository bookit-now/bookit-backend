{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "Jwt": {
    "Issuer": "BookIt",
    "AccessAudience": "bookit-api",
    "RefreshAudience": "bookit-refresh",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 15
  },
  "AllowedHosts": "*"
}
